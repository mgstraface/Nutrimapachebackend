# Copiar a .env y completar. El .env nunca se sube al repo.

# ---- Docker en el VPS (no se pisan con Casa Roma ni con el robot) ----
STACK=nutrimapache
WEB_PORT=8092
MONGO_PORT=27022
DOMAIN=

# ---- API ----
MONGO_URL=mongodb://localhost:27017/nutrimapache
# open = cualquiera crea cuenta · invite = solo el admin crea usuarios
REGISTRATION_MODE=invite
# Generar con: openssl rand -base64 48 (el script de deploy lo genera solo)
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
# Fase 4. Las claves de IA van solo acá, nunca en el frontend.
AI_PROVIDER=mock
