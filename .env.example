# Copiar a .env y completar. El .env nunca se sube al repo.

# ---- Docker en el VPS (no se pisan con Casa Roma ni con el robot) ----
STACK=nutrimapache
WEB_PORT=8092
MONGO_PORT=27022
DOMAIN=

# ---- API ----
MONGO_URL=mongodb://localhost:27017/nutrimapache
# Admin inicial: se crea al arrancar si no hay ningún admin. Los demás usuarios se crean desde el panel.
# En el VPS el script de deploy genera la contraseña solo.
ADMIN_USERNAME=mati
ADMIN_PASSWORD=
# Análisis de fotos con Claude. La clave va SOLO acá (nunca en el frontend ni en el repo).
# Sin clave, la opción de foto no aparece en la app.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Tope de fotos analizadas por persona por día
AI_DAILY_LIMIT=15
